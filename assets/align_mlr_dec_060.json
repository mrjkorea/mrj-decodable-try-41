    },
    {
      "page_id": "p03",
      "text": "Hana digs in the cold wild grass. She finds a bug and a nut.",
      "image": "books/mlr_dec_060/pages/p03.webp",
      "audio": "books/mlr_dec_060/audio/pages/p03.mp3",
      "duration_ms": 6086,
      "voice": "57785406027844b29b63a772a8477bc2",
