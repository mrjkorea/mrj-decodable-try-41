      "song_audio": "books/mlr_dec_060/audio/song/p04.mp3",
      "song_duration_ms": 7627
    },
    {
      "page_id": "p05",
      "text": "\"Gran! Hold out your hand!\" Hana drops the old gold ring in it.",
      "image": "books/mlr_dec_060/pages/p05.webp",
      "audio": "books/mlr_dec_060/audio/pages/p05.mp3",
      "duration_ms": 5459,
      "voice": "57785406027844b29b63a772a8477bc2",
