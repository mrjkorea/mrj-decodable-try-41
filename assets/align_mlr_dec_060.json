      "song_duration_ms": 6791
    },
    {
      "page_id": "p04",
      "text": "Then she finds gold in the cold mud by the base of the old post.",
      "image": "books/mlr_dec_060/pages/p04.webp",
      "audio": "books/mlr_dec_060/audio/pages/p04.mp3",
      "duration_ms": 5564,
      "voice": "57785406027844b29b63a772a8477bc2",
