      "song_duration_ms": 6687
    },
    {
      "page_id": "p07",
      "text": "But the sudsy puppy jumps out and runs away! Sunny runs after him.",
      "image": "books/mlr_dec_058/pages/p07.webp",
      "audio": "books/mlr_dec_058/audio/pages/p07.mp3",
      "duration_ms": 5773,
      "voice": "57785406027844b29b63a772a8477bc2",
