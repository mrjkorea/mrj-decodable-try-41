      "song_duration_ms": 7340
    },
    {
      "page_id": "p04",
      "text": "Turtles hatch on one shore. Turtles return to that shore to nest. Not a shore. That shore.",
      "image": "books/mlr_dec_055/pages/p04.webp",
      "audio": "books/mlr_dec_055/audio/pages/p04.mp3",
      "duration_ms": 8359,
      "voice": "57785406027844b29b63a772a8477bc2",
