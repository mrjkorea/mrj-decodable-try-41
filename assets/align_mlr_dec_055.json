    {
      "page_id": "p03",
      "text": "Turtles cannot rest under the surf. Turtles must surface and fill their lungs.",
      "image": "books/mlr_dec_055/pages/p03.webp",
      "audio": "books/mlr_dec_055/audio/pages/p03.mp3",
      "duration_ms": 6399,
      "voice": "57785406027844b29b63a772a8477bc2",
